#!/bin/bash
set -euo pipefail

dnf install -y python3.11 python3.11-pip curl

install -d -o ec2-user -g ec2-user /opt/${project_name}
printf '%s' '${app_source_base64}' | base64 -d > /opt/${project_name}/app.py
printf '%s' '${requirements_base64}' | base64 -d > /opt/${project_name}/requirements.txt
chown ec2-user:ec2-user /opt/${project_name}/app.py /opt/${project_name}/requirements.txt

python3.11 -m venv /opt/${project_name}/venv
/opt/${project_name}/venv/bin/pip install --no-cache-dir -r /opt/${project_name}/requirements.txt

curl --fail --silent --show-error --location \
  https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem \
  --output /etc/pki/tls/certs/rds-global-bundle.pem
chmod 0644 /etc/pki/tls/certs/rds-global-bundle.pem

cat > /etc/${project_name}.env <<'EOF'
DB_HOST=${db_host}
DB_PORT=${db_port}
DB_NAME=${db_name}
DB_USER=${db_user}
DB_PASSWORD_PARAMETER=${db_password_parameter}
EOF
chmod 0600 /etc/${project_name}.env

cat > /etc/systemd/system/${project_name}.service <<'EOF'
[Unit]
Description=Records API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/opt/${project_name}
EnvironmentFile=/etc/${project_name}.env
ExecStart=/opt/${project_name}/venv/bin/gunicorn --workers 1 --threads 2 --bind 0.0.0.0:5000 app:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now ${project_name}.service
